{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Visual Novel Script",
    "patterns": [
        {
            "include": "#contents"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#option_prompt"
        },
        {
            "include": "#double-slash"
        },
        {
            "include": "#number-sign"
        },
        {
            "include": "#reserved"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#heading"
        },
        {
            "include": "#boolean"
        },
        {
            "include": "#numbers"
        }
    ],
    "repository": {
        "boolean": {
            "match": "\\b(true|false)\\b",
            "name": "constant.language.boolean.vns"
        },
        "contents": {
            "captures": {
                "1": {
                    "name": "string.unquoted.vns"
                }
            },
            "match": "^\\s*-\\s+(.*?)(?=\\s*//|\\s*$)"
        },
        "double-slash": {
            "match": "//.*$",
            "name": "comment.line.double-slash.vns"
        },
        "heading": {
            "match": "^\\s*(.+?):\\s*$",
            "name": "markup.heading.vns"
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "Jump to reserved target (null / none / head)",
                    "match": "\\[(jump_|jump|jmp_|jmp)\\]\\s*(null|none|head)\\b",
                    "captures": {
                        "0": {
                            "name": "meta.label.vns"
                        },
                        "1": {
                            "name": "keyword.control.vns"
                        },
                        "2": {
                            "name": "constant.language.vns"
                        }
                    }
                },
                {
                    "comment": "Label definition or jump with label name",
                    "match": "\\[(label|jump_|jump|jmp_|jmp)\\]\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "0": {
                            "name": "meta.label.vns"
                        },
                        "1": {
                            "name": "keyword.control.vns"
                        },
                        "2": {
                            "name": "entity.name.label.vns"
                        }
                    }
                },
                {
                    "comment": "Hide all characters via wildcard",
                    "match": "\\[(hide)\\]\\s*(\\*)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.vns"
                        },
                        "2": {
                            "name": "constant.language.vns"
                        }
                    }
                },
                {
                    "match": "\\[(.*?)\\]",
                    "name": "keyword.control.vns"
                },
                {
                    "match": "\\+\\+|--|\\+=|-=|\\*=|/=|\\+|-|\\*|/|>=|<=|>|<|=|%",
                    "name": "keyword.operator.math.vns"
                }
            ]
        },
        "number-sign": {
            "match": "#.*$",
            "name": "comment.line.number-sign.vns"
        },
        "reserved": {
            "match": "\\b(null|none|head)\\b",
            "name": "constant.language.vns"
        },
        "numbers": {
            "patterns": [
                {
                    "match": "\\b\\d+\\.\\d+\\b",
                    "name": "constant.numeric.float.vns"
                },
                {
                    "match": "\\b\\d+\\b",
                    "name": "constant.numeric.integer.vns"
                }
            ]
        },
        "option_prompt": {
            "patterns": [
                {
                    "comment": "Option targeting a reserved target (null / none / head)",
                    "match": "\\[(option|opt)\\]\\s*(.*?)\\s*(->)\\s*(null|none|head)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.vns"
                        },
                        "2": {
                            "name": "string.unquoted.vns"
                        },
                        "3": {
                            "name": "keyword.operator.vns"
                        },
                        "4": {
                            "name": "constant.language.vns"
                        }
                    }
                },
                {
                    "match": "\\[(option|opt)\\]\\s*(.*?)\\s*(->)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.vns"
                        },
                        "2": {
                            "name": "string.unquoted.vns"
                        },
                        "3": {
                            "name": "keyword.operator.vns"
                        },
                        "4": {
                            "name": "entity.name.label.vns"
                        }
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.vns"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.vns"
                        }
                    },
                    "name": "string.quoted.double.vns",
                    "patterns": [
                        {
                            "match": "\\\\.",
                            "name": "constant.character.escape.vns"
                        }
                    ]
                },
                {
                    "begin": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.vns"
                        }
                    },
                    "end": "'",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.vns"
                        }
                    },
                    "name": "string.quoted.single.vns",
                    "patterns": [
                        {
                            "match": "\\\\.",
                            "name": "constant.character.escape.vns"
                        }
                    ]
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "comment": "Global variables were removed in VNS 3.0 (VEP 6)",
                    "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
                    "name": "invalid.illegal.global-variable.vns"
                },
                {
                    "comment": "Persistent variable with & prefix",
                    "match": "&([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "0": {
                            "name": "variable.other.persistent.vns"
                        }
                    }
                },
                {
                    "comment": "Variable assignment or operation",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\+\\+|--|\\+=|-=|\\*=|/=|=)",
                    "captures": {
                        "1": {
                            "name": "variable.other.local.vns"
                        },
                        "2": {
                            "name": "keyword.operator.assignment.vns"
                        }
                    }
                },
                {
                    "comment": "Variable reference in expression (RHS of = or math operator)",
                    "match": "(?<=[=+\\-*/%])\\s*(?!(?:true|false|null|none|head)\\b)([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "variable.other.local.vns"
                        }
                    }
                }
            ]
        }
    },
    "scopeName": "source.vns"
}